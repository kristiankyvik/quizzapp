#!/usr/bin/env bash
# Start the Rails app for the Lovable preview using the vintage Ruby toolchain.
set -e
rm -f /dev-server/tmp/pids/server.pid
cd /dev-server
# The sandbox wipes /tmp between sessions; re-provision if the gems are gone.
if [ ! -d /tmp/ruby23-gems/gems ]; then
  bin/lovable-install
else
  bin/pg-start || true
fi
exec bin/renv.sh bash -c 'cd /dev-server && bundle _1.17.3_ exec rails server -b 0.0.0.0 -p 8080'
