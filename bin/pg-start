#!/usr/bin/env bash
# Start a local PostgreSQL 11 instance for the app (data kept in /tmp).
set -e
PGUSER_OS=lovable
PGDATA=/tmp/pgdata
PGRUN=/tmp/pgrun
mkdir -p "$PGRUN"
chmod 777 "$PGRUN"

/dev-server/bin/renv.sh bash -c '
  set -e
  PGDATA=/tmp/pgdata
  PGRUN=/tmp/pgrun
  OSUSER=lovable
  if pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1; then
    echo "postgres already running"
  else
    if [ ! -s "$PGDATA/PG_VERSION" ]; then
      rm -rf "$PGDATA"; mkdir -p "$PGDATA"
    fi
    chown -R $OSUSER "$PGDATA" "$PGRUN"
    if [ ! -s "$PGDATA/PG_VERSION" ]; then
      setpriv --reuid=1000 --regid=1000 --clear-groups bash -c "initdb -D $PGDATA -U postgres -E UTF8"
    fi
    setpriv --reuid=1000 --regid=1000 --clear-groups bash -c "pg_ctl -D $PGDATA -l /tmp/pg.log -o \"-h 127.0.0.1 -p 5432 -k $PGRUN\" -w start"
    for i in $(seq 1 30); do pg_isready -h 127.0.0.1 -p 5432 >/dev/null 2>&1 && break; sleep 1; done
  fi
  for db in quizzapp_development quizzapp_test; do
    psql -h 127.0.0.1 -U postgres -d postgres -tAc "select 1 from pg_database where datname='"'"'$db'"'"'" | grep -q 1 \
      || createdb -h 127.0.0.1 -U postgres "$db"
  done
  psql -h 127.0.0.1 -U postgres -d postgres -tAc "select version()"
'
